<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <!-- Primary Video Surface View (Hardware-Accelerated ExoPlayer) -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:use_controller="false"
        app:surface_type="surface_view"
        app:resize_mode="fill" />

    <!-- Connected Empty State (Shown when Connected to Client Admin with 0 Ads) -->
    <LinearLayout
        android:id="@+id/emptyAdsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:background="@color/hinopt_dark"
        android:visibility="gone"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HINOPT"
            android:textColor="@color/hinopt_gold"
            android:textSize="38sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:id="@+id/tvConnectedScreenName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Screen Connected"
            android:textColor="#4ADE80"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No ads scheduled yet.\nAdd ads in Client Business Admin to view on this screen."
            android:textColor="@color/hinopt_gray"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginTop="12dp" />
    </LinearLayout>

    <!-- Onboarding Overlay: License Key Entry -> HINOPT Approval -> QR Scan -->
    <LinearLayout
        android:id="@+id/pairingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:background="@color/hinopt_dark"
        android:visibility="gone"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HINOPT"
            android:textColor="@color/hinopt_gold"
            android:textSize="40sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Client-Owned Digital Signage Setup"
            android:textColor="@color/hinopt_gray"
            android:textSize="16sp"
            android:layout_marginTop="4dp" />

        <!-- Stage 1: License Key + Screen Name Input -->
        <LinearLayout
            android:id="@+id/licenseEntryGroup"
            android:layout_width="420dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/etLicenseKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Client License Key (e.g. HNPT-XXXX-XXXX)"
                android:textColor="@color/white"
                android:textColorHint="#94A3B8"
                android:background="#1E293B"
                android:padding="14dp"
                android:inputType="textCapCharacters" />

            <EditText
                android:id="@+id/etScreenName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Screen Name (e.g. Auto #01 - HITEC City)"
                android:textColor="@color/white"
                android:textColorHint="#94A3B8"
                android:background="#1E293B"
                android:padding="14dp"
                android:layout_marginTop="12dp" />

            <Button
                android:id="@+id/btnSubmitLicense"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Submit &amp; Request HINOPT Approval"
                android:textStyle="bold"
                android:backgroundTint="@color/hinopt_gold"
                android:textColor="@color/black"
                android:layout_marginTop="16dp" />
        </LinearLayout>

        <!-- Stage 2: Waiting for HINOPT Approval -->
        <LinearLayout
            android:id="@+id/waitingApprovalGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginTop="28dp"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="@color/hinopt_gold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Waiting for HINOPT Approval..."
                android:textColor="@color/hinopt_gold"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/tvPendingInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Please confirm this device in HINOPT Super-Admin."
                android:textColor="@color/hinopt_gray"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Stage 3: Approved -> Display QR Code to Scan in Client Admin -->
        <LinearLayout
            android:id="@+id/qrScanGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Approved! Scan QR in Client Business Admin"
                android:textColor="#4ADE80"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivQrCode"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:background="@color/white"
                android:padding="10dp"
                android:layout_marginTop="16dp"
                android:contentDescription="QR Code to connect screen" />

            <TextView
                android:id="@+id/tvActivationCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QR-XXXXXX"
                android:textColor="@color/hinopt_gold"
                android:textSize="26sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvScreenStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connected to HINOPT Cloud"
            android:textColor="@color/hinopt_gray"
            android:textSize="12sp"
            android:layout_marginTop="20dp" />

    </LinearLayout>

    <!-- Quarantine & Tamper Mode Overlay -->
    <LinearLayout
        android:id="@+id/quarantineOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:background="#7F1D1D"
        android:visibility="gone"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SECURITY QUARANTINE"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_quarantine"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:layout_marginTop="12dp"
            android:gravity="center" />
    </LinearLayout>

    <!-- Invisible Top-Right Corner Touch Zone for Owner / Technician Kiosk Exit (5 Taps) -->
    <View
        android:id="@+id/ownerExitTouchZone"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="top|end"
        android:background="@android:color/transparent" />

</FrameLayout>
