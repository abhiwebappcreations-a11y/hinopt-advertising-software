<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <!-- Primary Video Surface View (Hardware-Accelerated ExoPlayer) -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:surface_type="surface_view"
        app:resize_mode="fill" />

    <!-- Neutral Pairing Screen Overlay (Shown when un-enrolled; Zero Demo Data) -->
    <LinearLayout
        android:id="@+id/pairingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:background="@color/hinopt_dark"
        android:visibility="gone"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HINOPT"
            android:textColor="@color/hinopt_gold"
            android:textSize="42sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Automotive Digital Signage Kiosk"
            android:textColor="@color/hinopt_gray"
            android:textSize="18sp"
            android:layout_marginTop="8dp" />

        <View
            android:layout_width="120dp"
            android:layout_height="2dp"
            android:background="@color/hinopt_navy"
            android:layout_marginVertical="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pairing_instruction"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <!-- 6-Digit Screen Activation Code Display -->
        <TextView
            android:id="@+id/tvActivationCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="A9X4B2"
            android:textColor="@color/hinopt_gold"
            android:textSize="56sp"
            android:textStyle="bold"
            android:letterSpacing="0.25"
            android:background="#1E293B"
            android:paddingHorizontal="48dp"
            android:paddingVertical="12dp"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/tvScreenStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_unregistered"
            android:textColor="@color/hinopt_gray"
            android:textSize="14sp"
            android:layout_marginTop="24dp" />

    </LinearLayout>

    <!-- Quarantine & Tamper Mode Overlay -->
    <LinearLayout
        android:id="@+id/quarantineOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:background="#7F1D1D"
        android:visibility="gone"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SECURITY QUARANTINE"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_quarantine"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:layout_marginTop="12dp"
            android:gravity="center" />
    </LinearLayout>

</FrameLayout>
